# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Set your public HTTPS origin before deployment, for example https://salon.example
APP_ORIGIN=

# Optional first-time owner setup. Otherwise a random password is generated.
# ADMIN_SETUP_EMAIL=owner@hairmasters.local
# ADMIN_SETUP_PASSWORD=

# Optional serverless owner login. Generate private values with npm run admin:export.
# Never put real values in this example or prefix them with NEXT_PUBLIC_.
# ADMIN_AUTH_ACCOUNT=
# ADMIN_SESSION_SECRET=
